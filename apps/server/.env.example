DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
# Acceso de emergencia al admin: sin email, esta contraseña entra como el admin de arranque (admin@localhost).
KEEL_ADMIN_PASSWORD=
# Base de datos: sqlite (por defecto, un archivo en KEEL_DB_PATH) o postgres (necesita POSTGRES_DSN).
DB_ENGINE=sqlite
KEEL_DB_PATH=./data/keel.db
# Solo con DB_ENGINE=postgres. keel crea y migra sus tablas al arrancar.
# POSTGRES_DSN=postgres://keel:contraseña@localhost:5432/keel
KEEL_CI_EXPIRY_MINUTES=60
KEEL_DEPLOY_TIMEOUT_MINUTES=15
# optional (default): /api accepts calls without a token, but a token that is sent must be valid.
# required: every /api route except /api/health and /api/ci-result needs a token from "Tokens de API".
KEEL_API_AUTH=optional
# Rol de las llamadas a /api sin token mientras KEEL_API_AUTH=optional: none, viewer, publisher o deployer.
# deployer (por defecto) mantiene el comportamiento anterior a los roles. Con KEEL_API_AUTH=required no se usa.
KEEL_ANONYMOUS_ROLE=deployer
# Cuánto puede esperar un deploy su aprobación (cuando el scope la pide) antes de quedar expired. Por defecto 24 h.
KEEL_APPROVAL_EXPIRY_MINUTES=1440
# Zona horaria (IANA) que el admin propone para las ventanas de congelamiento nuevas.
KEEL_TIMEZONE=UTC
# URL pública de keel; con ella las notificaciones enlazan al deploy en el admin.
# KEEL_PUBLIC_URL=https://keel.example.com

# Notificaciones (opcional). Se suman a los canales creados en el admin (Notificaciones); una URL repetida avisa una vez.
# Las URLs de webhook son secretos: no se muestran completas ni en el admin ni en los logs.
# KEEL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# KEEL_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
# KEEL_WEBHOOK_URL=https://ops.example.com/keel
# Firma el cuerpo de KEEL_WEBHOOK_URL: header X-Keel-Signature: sha256=<hmac>.
# KEEL_WEBHOOK_SECRET=
# Eventos que reciben los canales del entorno, separados por comas (vacío o * = todos):
# deploy.deployed, deploy.failed, deploy.ci_failed, deploy.expired, deploy.rollback, deploy.approval_requested,
# deploy.approved, deploy.rejected, deploy.forced
# KEEL_NOTIFY_EVENTS=deploy.failed,deploy.rollback

# Métricas de Prometheus en GET /api/metrics, con Authorization: Bearer <token>. Sin token el endpoint está apagado.
# KEEL_METRICS_TOKEN=
# Logs: json (una línea JSON por evento, por defecto) o text. Nivel: debug, info, warn o error.
KEEL_LOG_FORMAT=json
KEEL_LOG_LEVEL=info
