DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
KEEL_ADMIN_PASSWORD=
# Base de datos: sqlite (por defecto, un archivo en KEEL_DB_PATH) o postgres (necesita POSTGRES_DSN).
DB_ENGINE=sqlite
KEEL_DB_PATH=./data/keel.db
# Solo con DB_ENGINE=postgres. keel crea y migra sus tablas al arrancar.
# POSTGRES_DSN=postgres://keel:contraseña@localhost:5432/keel
KEEL_CI_EXPIRY_MINUTES=60
KEEL_DEPLOY_TIMEOUT_MINUTES=15
# optional (default): /api accepts calls without a token, but a token that is sent must be valid.
# required: every /api route except /api/health and /api/ci-result needs a token from "Tokens de API".
KEEL_API_AUTH=optional
